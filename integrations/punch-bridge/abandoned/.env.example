# Copy to .env and fill in. Keep .env off any shared drive.

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://rqgkzamuohdvttnkluzn.supabase.co
# The public anon key — the same one the website uses. Safe on this PC.
SUPABASE_ANON_KEY=

# The ingest secret. NOT the service-role key: this one can only submit
# punches, which is the point of it existing.
#   Get it: Supabase → SQL Editor →
#   select secret from cb_integration_secrets where name = 'punch_bridge';
PUNCH_INGEST_SECRET=

# ── Local MS SQL (the Parallel Database Export target) ────────
MSSQL_SERVER=localhost
MSSQL_DATABASE=TimeTrack
MSSQL_TABLE=AttendanceLogs
# Leave MSSQL_USER blank to use the Windows login, which is how a default
# SQL Server Express install is set up. Fill both in for SQL authentication.
MSSQL_USER=
MSSQL_PASSWORD=
# Set if SQL Server runs as a named instance, e.g. SQLEXPRESS
MSSQL_INSTANCE=

# ── Timing ────────────────────────────────────────────────────
# How far back each run re-reads. 36 hours covers an overnight outage and
# still catches yesterday's evening punches. Re-sending is free.
LOOKBACK_HOURS=36
INTERVAL_SECONDS=120
