# A long random string. Generate one with:  openssl rand -hex 32
# This becomes WA_WEBHOOK_TOKEN on the Supabase side. Nothing else authorises
# a send, so treat it like a password.
WA_TOKEN=

# Where this listens. Put a reverse proxy in front of it for HTTPS —
# Supabase Edge Functions will not call a plain-HTTP URL.
PORT=8099

# Where WhatsApp credentials are stored. Keep it off any public path and
# out of git: whoever holds this directory holds the linked account.
WA_AUTH_DIR=./auth

# warn is right for normal running. Use info while debugging a link.
LOG_LEVEL=warn
